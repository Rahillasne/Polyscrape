---
/**
 * The single landing page.
 *
 * Imports src/data/deadlines.json (owned by another agent) typed as
 * Deadline[], sorts by soonest deadline at build time, and renders one Card
 * per program. The client script (app.ts) enhances the existing DOM:
 * filtering, search, live re-sort, countdown ticks, .ics export, report links,
 * and the theme toggle.
 */
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import type { Deadline } from "../types";
import { SITE_TITLE, SITE_SUBTITLE, GITHUB_REPO } from "../config";

// resolveJsonModule lets us import the dataset directly. We assert the shape;
// the data agent guarantees the 16-key contract.
import rawDeadlines from "../data/deadlines.json";
const deadlines = rawDeadlines as Deadline[];

/** Soonest upcoming first; rolling + closed sort last. */
function sortKey(d: Deadline): number {
  const FAR_FUTURE = Number.MAX_SAFE_INTEGER;
  if (d.rolling || !d.deadline) return FAR_FUTURE;
  const t = Date.parse(d.deadline);
  if (Number.isNaN(t)) return FAR_FUTURE;
  if (t < Date.now()) return FAR_FUTURE - 1;
  return t;
}

const sorted = [...deadlines].sort((a, b) => sortKey(a) - sortKey(b));

/**
 * The slug of the single nearest UPCOMING (non-rolling, non-closed) deadline,
 * highlighted distinctly. Empty string when there is none.
 */
const now = Date.now();
const upcoming = sorted.filter((d) => {
  if (d.rolling || !d.deadline) return false;
  const t = Date.parse(d.deadline);
  return !Number.isNaN(t) && t > now;
});
const featuredSlug = upcoming.length > 0 ? upcoming[0]!.slug : "";

const total = sorted.length;

const TABS = [
  { id: "all", label: "All" },
  { id: "accelerator", label: "Accelerators" },
  { id: "competition", label: "Competitions" },
  { id: "grant", label: "Grants" },
  { id: "fellowship", label: "Fellowships" },
];
---

<Base title={SITE_TITLE}>
  <header class="site-header shell">
    <a class="brand" href="/">
      <svg class="brand__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="11" stroke="var(--accent)" stroke-width="1.5" />
        <path d="M12 6v6l4 2" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{SITE_TITLE}</span>
    </a>

    <button
      type="button"
      class="theme-toggle"
      id="theme-toggle"
      aria-label="Toggle dark mode"
      title="Toggle dark mode"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
      </svg>
    </button>
  </header>

  <main class="shell">
    <section class="hero">
      <h1 class="hero__title">
        Funding <span class="accent">deadlines</span>, all in one place.
      </h1>
      <p class="hero__subtitle">{SITE_SUBTITLE}</p>
    </section>

    <section class="controls" aria-label="Filter and sort programs">
      <div class="tabs" role="tablist" aria-label="Category">
        {
          TABS.map((tab, i) => (
            <button
              type="button"
              class="tab"
              role="tab"
              data-tab={tab.id}
              aria-selected={i === 0 ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      <div class="controls__row">
        <div class="search">
          <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="search"
            class="search__input"
            placeholder="Search name, organizer, or location…"
            aria-label="Search programs"
            autocomplete="off"
          />
        </div>

        <div class="select-wrap">
          <label class="visually-hidden" for="sort">Sort by</label>
          <select id="sort" class="select">
            <option value="soonest">Sort: Soonest deadline</option>
            <option value="latest">Sort: Latest deadline</option>
            <option value="name">Sort: Name (A–Z)</option>
          </select>
        </div>

        <button type="button" class="btn-ghost" id="export-category" title="Download visible programs as a calendar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke-linecap="round" />
          </svg>
          Export .ics
        </button>
      </div>
    </section>

    <p class="results-meta" id="results-meta" aria-live="polite">
      Showing {total} of {total} programs
    </p>

    <section class="grid" id="grid" aria-label="Funding programs">
      {sorted.map((item) => <Card item={item} />)}
    </section>

    <div class="empty" id="empty" hidden>
      <p>No programs match your filters. Try clearing the search or switching tabs.</p>
    </div>
  </main>

  <footer class="site-footer shell">
    <span>
      {SITE_TITLE} — community-maintained. Always confirm dates with the official source.
    </span>
    <a href={`https://github.com/${GITHUB_REPO}`} target="_blank" rel="noopener noreferrer">
      Contribute on GitHub
    </a>
  </footer>

  {/* Config the client script reads (repo for issue links, featured slug). */}
  <script
    type="application/json"
    id="fd-config"
    set:html={JSON.stringify({
      githubRepo: GITHUB_REPO,
      siteTitle: SITE_TITLE,
      featuredSlug,
    })}
  />

  <script>
    import "../scripts/app";
  </script>
</Base>
